{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phrase-potato-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Only pages on these origins may open a connection. `npm run dev` uses .dev.vars instead.
    "ALLOWED_ORIGINS": "https://games.isobotka.ca"
  }
}
